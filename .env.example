# ============================================
# SmartSheet AI — Environment Variables
# ============================================
# Nusxalab .env qiling:
#   cp .env.example .env
# Keyin AI kalitni to'ldiring.
# ============================================

# --- Ilova ---
APP_NAME=SmartSheet AI
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# --- AI provayderi ---
# Provayderlar: 'groq' | 'openai' | 'gemini' | 'demo'
# 'demo' = AI ishlatilmaydi, namunaviy jadval qaytariladi
AI_PROVIDER=demo

# API kalit (faqat backendda saqlanadi)
# Groq: https://console.groq.com/keys
# OpenAI: https://platform.openai.com/api-keys
AI_API_KEY=

# Model nomi (provayderga qarab)
# Groq misollari: openai/gpt-oss-120b, llama-3.1-8b-instant
# OpenAI misollari: gpt-4o-mini, gpt-4o
AI_MODEL=

# API manzili (OpenAI-mos format)
# Groq:  https://api.groq.com/openai/v1/chat/completions
# OpenAI: https://api.openai.com/v1/chat/completions
AI_API_URL=

# --- Cheklovlar ---
MAX_ROWS=100
MAX_COLUMNS=20
MAX_PROMPT_LENGTH=2000

# --- Undo tarixi ---
MAX_HISTORY_SIZE=20