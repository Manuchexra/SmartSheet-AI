# ============================================
# SmartSheet AI — Environment Variables
# ============================================

# --- Ilova ---
APP_NAME=SmartSheet AI
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# --- AI provayderi ---
# Provayderlar: 'groq' | 'openai' | 'gemini' | 'demo'
AI_PROVIDER=demo
AI_API_KEY=
AI_MODEL=
AI_API_URL=

# --- Ma'lumotlar bazasi (12-bosqich) ---
# SQLite: sqlite:///./data/smartsheet.db
# PostgreSQL: postgresql://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///./data/smartsheet.db

# --- Cheklovlar ---
MAX_ROWS=100
MAX_COLUMNS=20
MAX_PROMPT_LENGTH=2000

# --- Undo tarixi ---
MAX_HISTORY_SIZE=20

# --- Chat sozlamalari (12-bosqich) ---
MAX_CHATS=100
MAX_MESSAGES_PER_CHAT=500